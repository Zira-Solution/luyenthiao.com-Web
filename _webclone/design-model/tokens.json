{
  "color": {
    "brand": { "primary": "#0075fb", "onPrimary": "#ffffff" },
    "semantic": { "success": "#52c41a", "warning": "#faad14", "danger": "#f5222d", "info": "#1677ff" },
    "surfaces": { "background": "#16143c", "surface": "#ffffff", "border": "#e5e7eb" },
    "text": { "primary": "#ffffff", "secondary": "#323131", "muted": "#6b7280" }
